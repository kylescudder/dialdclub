---
import VariationIntro from "./VariationIntro.astro";
---

<section
  class="variant variant-midnight"
  id="midnight-calibration"
  aria-labelledby="midnight-title"
>
  <div class="calibration-grid" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span
    ></span>
  </div>
  <VariationIntro
    kicker="Variation 02 / Midnight calibration"
    title="A cockpit for serious brew experiments."
    titleId="midnight-title"
    lede="Track grind, temperature, ratio, yield, and tasting notes in seconds. See the pattern before the bag disappears."
    buttons={[
      {
        href: "https://github.com/kylescudder/dialdclub",
        label: "Open GitHub",
        class: "button-acid",
      },
      { href: "#origin-fieldnotes", label: "Compare", class: "button-glass" },
    ]}
  />
  <div class="radar-panel" aria-hidden="true">
    <div class="radar-sweep"></div>
    <div class="radar-center"><strong>1:16</strong><span>balanced</span></div>
    <div class="readout readout-a">Temp 94C</div>
    <div class="readout readout-b">Grind 22</div>
    <div class="readout readout-c">Drawdown 2:48</div>
  </div>
</section>
