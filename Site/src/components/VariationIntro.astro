---
interface ButtonLink {
  href: string;
  label: string;
  class: string;
}

interface Props {
  kicker: string;
  title: string;
  titleId: string;
  headingLevel?: "h1" | "h2";
  lede: string;
  buttons: ButtonLink[];
}

const {
  kicker,
  title,
  titleId,
  headingLevel = "h2",
  lede,
  buttons,
} = Astro.props;
const Heading = headingLevel;
---

<div class="variant-copy">
  <p class="kicker">{kicker}</p>
  <Heading id={titleId}>{title}</Heading>
  <p class="lede">{lede}</p>
  <div class="button-row">
    {
      buttons.map((button) => (
        <a class={`button ${button.class}`} href={button.href}>
          {button.label}
        </a>
      ))
    }
  </div>
</div>
