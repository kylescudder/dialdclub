---
interface Props {
  title: string;
  updated: string;
}

const { title, updated } = Astro.props;
---

<main class="legal-shell">
  <article class="legal">
    <p class="kicker">Diald Club</p>
    <h1>{title}</h1>
    <p class="updated">Last updated: {updated}</p>
    <slot />
  </article>
</main>
