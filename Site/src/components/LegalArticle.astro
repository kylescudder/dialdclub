---
interface Props {
  title: string;
  updated?: string;
}

const { title, updated } = Astro.props;
---

<main class="legal-shell wrap">
  <article class="legal prose legal-policy">
    <p class="eyebrow">Diald Club</p>
    <h1>{title}</h1>
    {updated && <p class="updated">Last updated: {updated}</p>}
    <slot />
  </article>
</main>
