---
const path = Astro.url.pathname;
const current = path === "/" ? "home" : path.split("/").filter(Boolean)[0];
const featuresHref = current === "home" ? "#features" : "/#features";
---

<header class="top-nav">
  <a class="nav-logo" href="/" aria-label="Diald Club home">
    <img src="/assets/diald-icon.png" alt="" width="32" height="32" />
    <span>Diald Club</span>
  </a>
  <nav class="nav-links" aria-label="Main navigation">
    <a href="/" aria-current={current === "home" ? "page" : undefined}
      >Overview</a
    >
    <a href={featuresHref}>Features</a>
    <a href="/privacy" aria-current={current === "privacy" ? "page" : undefined}
      >Privacy</a
    >
    <a href="/terms" aria-current={current === "terms" ? "page" : undefined}
      >Terms</a
    >
    <a href="/support" aria-current={current === "support" ? "page" : undefined}
      >Support</a
    >
  </nav>
  <div class="nav-actions">
    <a
      class="nav-button secondary"
      href="https://github.com/kylescudder/dialdclub">GitHub</a
    >
    <a class="nav-button" href={featuresHref}>Explore</a>
  </div>
</header>
