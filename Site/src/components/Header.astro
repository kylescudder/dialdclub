---
export interface NavLink {
  href: string;
  label: string;
  class?: string;
}

interface Props {
  navLinks?: NavLink[];
}

const path = Astro.url.pathname;
const defaultNavLinks = path.startsWith("/privacy")
  ? [
      { href: "/#support", label: "Support", class: "nav-word" },
      { href: "/terms", label: "Terms", class: "nav-word" },
    ]
  : path.startsWith("/terms")
    ? [
        { href: "/#support", label: "Support", class: "nav-word" },
        { href: "/privacy", label: "Privacy", class: "nav-word" },
      ]
    : [
        { href: "#barista-ledger", label: "01" },
        { href: "#midnight-calibration", label: "02" },
        { href: "#origin-fieldnotes", label: "03" },
        { href: "#espresso-brutalist", label: "04" },
        { href: "#slow-bar-luxe", label: "05" },
        { href: "#support", label: "Support", class: "nav-word" },
      ];

const { navLinks = defaultNavLinks } = Astro.props;
---

<header class="site-header">
  <a class="brand-link" href="/" aria-label="Diald Club home">
    <span class="logo" aria-hidden="true"
      ><img src="/assets/diald-icon.png" alt="" /></span
    >
    <span class="wordmark">Diald Club</span>
  </a>
  {
    navLinks.length > 0 && (
      <nav class="variant-nav" aria-label="Site links">
        {navLinks.map((link) => (
          <a class={link.class} href={link.href}>
            {link.label}
          </a>
        ))}
      </nav>
    )
  }
</header>
