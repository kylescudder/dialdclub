---
import VariationIntro from "./VariationIntro.astro";
---

<section
  class="variant variant-brutalist"
  id="espresso-brutalist"
  aria-labelledby="brutalist-title"
>
  <div class="stamp" aria-hidden="true">DIALD</div>
  <VariationIntro
    kicker="Variation 04 / Espresso brutalist"
    title="Stop guessing. Pull, log, adjust, repeat."
    titleId="brutalist-title"
    lede="A sharp, no-nonsense presentation for espresso people who want fast entries, visible deltas, and fewer mystery shots."
    buttons={[
      {
        href: "https://github.com/kylescudder/dialdclub",
        label: "GitHub",
        class: "button-block",
      },
      {
        href: "#slow-bar-luxe",
        label: "View 05",
        class: "button-outline-heavy",
      },
    ]}
  />
  <div class="shot-table" aria-hidden="true">
    <div><span>IN</span><b>18.5</b></div>
    <div><span>OUT</span><b>42.0</b></div>
    <div><span>TIME</span><b>31s</b></div>
    <div><span>NOTE</span><b>+FINER</b></div>
  </div>
</section>
