---
import VariationIntro from "./VariationIntro.astro";
---

<section
  class="variant variant-luxe"
  id="slow-bar-luxe"
  aria-labelledby="luxe-title"
>
  <VariationIntro
    kicker="Variation 05 / Slow bar luxe"
    title="A calmer way to collect better cups."
    titleId="luxe-title"
    lede="For a polished App Store-feeling site: tactile, premium, and quiet, with the product framed as a daily coffee ritual."
    buttons={[
      {
        href: "https://github.com/kylescudder/dialdclub",
        label: "View project",
        class: "button-gold",
      },
      { href: "#barista-ledger", label: "Back to top", class: "button-silk" },
    ]}
  />
  <div class="luxe-stage" aria-hidden="true">
    <img class="app-icon" src="/assets/diald-icon.png" alt="" />
    <div class="luxe-phone">
      <span>Diald Club</span>
      <strong>Morning recipe saved</strong>
      <p>V60 / 20g / 320g / 3:04</p>
    </div>
  </div>
</section>
