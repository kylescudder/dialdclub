---
import type { NavLink } from "./Header.astro";

interface Props {
  footerLabel?: string;
  footerLinks?: NavLink[];
}

const path = Astro.url.pathname;
const defaultFooterLabel =
  path === "/" ? "Five promotional directions for Diald Club" : "Diald Club";
const defaultFooterLinks =
  path === "/"
    ? [
        { href: "/support", label: "Support" },
        { href: "/privacy", label: "Privacy" },
        { href: "/terms", label: "Terms" },
        { href: "https://github.com/kylescudder/dialdclub", label: "GitHub" },
      ]
    : [
        { href: "/support", label: "Support" },
        { href: "/privacy", label: "Privacy" },
        { href: "/terms", label: "Terms" },
      ];

const { footerLabel = defaultFooterLabel, footerLinks = defaultFooterLinks } =
  Astro.props;
---

<footer>
  <span>{footerLabel}</span>
  <span class="footer-links">
    {
      footerLinks.map((link) => (
        <a class={link.class} href={link.href}>
          {link.label}
        </a>
      ))
    }
  </span>
</footer>
