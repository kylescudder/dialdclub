---
import "../styles/global.css";
import DocumentHead from "../components/DocumentHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { NavLink } from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  bodyClass?: string;
  navLinks?: NavLink[];
  footerLabel?: string;
  footerLinks?: NavLink[];
}

const {
  title,
  description,
  ogTitle = title,
  bodyClass = "",
  navLinks = [],
  footerLabel = "Diald Club",
  footerLinks = [
    { href: "/#support", label: "Support" },
    { href: "/privacy", label: "Privacy" },
    { href: "/terms", label: "Terms" },
  ],
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <DocumentHead title={title} description={description} ogTitle={ogTitle} />
  </head>
  <body class={bodyClass}>
    <SiteHeader navLinks={navLinks} />
    <slot />
    <SiteFooter footerLabel={footerLabel} footerLinks={footerLinks} />
  </body>
</html>
